{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Grpc.Net.Client": "Warning"
    }
  },
  "AlertService": {
    "Endpoint": "http://localhost:50052",
    "TimeoutMs": 2000,
    "DebounceSeconds": 60,
    "MaxRetries": 3
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "IssuesTopic": "issues.events",
    "QueryTopic": "analytics.query",
    "ReplyTopic": "analytics.reply",
    "IssuesGroupId": "jira-analytics-issues-consumer",
    "QueryGroupId": "jira-analytics-query-consumer",
    "AutoOffsetReset": "Earliest"
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "analytics_db",
    "SnapshotsCollection": "sprint_snapshots",
    "VelocityCollection": "velocity_history",
    "AlertsCollection": "alerts"
  }
}
